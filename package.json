{
  "name": "openclaw-plugin-mtrace",
  "version": "0.2.1",
  "description": "Reset-aware session evidence export for OpenClaw 2026.9.6",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "openclaw plugins build",
    "validate": "openclaw plugins validate --json",
    "pack": "openclaw plugins pack --json",
    "test:local": "node --experimental-loader ./tests/sdk-loader.mjs --test tests/*.test.mjs"
  },
  "files": [
    "dist",
    "src",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE",
    "MIGRATION-NOTES.md",
    "THIRD-PARTY-LICENSES.md"
  ],
  "peerDependencies": {
    "openclaw": "2026.9.6"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "controlUi": "./src/control-ui.js",
    "compat": {
      "pluginApi": "2026.9.6"
    },
    "build": {
      "openclawVersion": "2026.9.6"
    }
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cyan119x/mtrace.git"
  },
  "homepage": "https://github.com/cyan119x/mtrace#readme",
  "bugs": {
    "url": "https://github.com/cyan119x/mtrace/issues"
  }
}
