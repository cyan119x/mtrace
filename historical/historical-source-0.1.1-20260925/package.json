{
  "name": "openclaw-plugin-mtrace",
  "version": "0.1.1",
  "description": "MTrace session evidence export as an OpenClaw Feature Plugin",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "openclaw plugins build",
    "validate": "openclaw plugins validate --json",
    "pack": "openclaw plugins pack --json",
    "test:local": "node --test tests/*.test.mjs"
  },
  "files": [
    "dist",
    "src/control-ui.js",
    "src/control-ui.css",
    "openclaw.plugin.json",
    "README.md",
    "MIGRATION-NOTES.md",
    "MIRA-HANDOFF.md",
    "REVISION-0.1.1.md",
    "MIRA-HANDOFF-0.1.1.md"
  ],
  "peerDependencies": {
    "openclaw": ">=2026.9.6"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "controlUi": "./src/control-ui.js",
    "compat": {
      "pluginApi": ">=2026.9.6"
    },
    "build": {
      "openclawVersion": "2026.9.6"
    }
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
